# Client-side Firebase Configuration (Provided in project specification)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ImageKit Configuration (Client Public URL & ID)
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Server-Side Only Secrets (Never expose to client bundle)
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
FIREBASE_SERVICE_ACCOUNT_KEY=your_service_account_json_base64_or_path

# Backend API Configuration (Empty string for relative local Next.js API routes)
NEXT_PUBLIC_API_URL=
