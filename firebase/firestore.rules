rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Schema Validators for Noxderma ERP
    // ===============================================================
    function isValidDocSize() {
      return request.resource.data.keys().size() <= 60;
    }

    function hasValidId() {
      return !('id' in request.resource.data) ||
        (request.resource.data.id is string && request.resource.data.id.size() >= 1 && request.resource.data.id.size() <= 150);
    }

    function isValidErpWrite() {
      return isValidDocSize() && hasValidId();
    }

    // Core ERP Collections synchronized with IndexedDB (offlineDb)
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /organizationSettings/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /categories/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /products/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /productPricing/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /inventoryBatches/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /stockMovements/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /inventoryProjections/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /customers/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /leads/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /customerVisits/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /invoices/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /payments/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /manufacturers/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /purchaseOrders/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /salesBookings/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /onlineOrders/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /salesReturns/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /marketingCampaigns/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /employeeTargets/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /users/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /coupons/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /staffMonitors/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /dailyBeatPlans/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /liveMapPins/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /geoVerifiedPhotos/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /auditLogs/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /syncOperations/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /syncConflicts/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /operatingExpenses/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /staffSalaries/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /partnerTransactions/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    match /partnerSettings/{docId} {
      allow read: if true;
      allow create, update: if isValidErpWrite();
      allow delete: if true;
    }

    // Default deny for any unmapped collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
